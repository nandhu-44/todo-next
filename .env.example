# Required in production: long random string used to sign session cookies
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: MongoDB. If omitted, data is stored in ./data/db.json (great for local dev)
MONGO_URI=
MONGO_DB=todo-next

# Passkeys are tied to your site's domain. By default it is taken from the request; pin it in production:
# WEBAUTHN_RP_ID=todo.example.com
# WEBAUTHN_ORIGIN=https://todo.example.com

# Bot protection (sign-up, password reset, and sign-in after 3 wrong passwords).
#   unset / pow   built-in proof-of-work check, no account needed (a speed bump, not a real bot detector)
#   turnstile     Cloudflare Turnstile (recommended for production): set both keys below
#   off           disable (tests, trusted deployments)
# CAPTCHA_PROVIDER=pow
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional: enables GET /api/health?deep=1 (send it as "Authorization: Bearer <token>") to measure database latency
HEALTH_TOKEN=

# Optional limits (defaults shown)
# MAX_TODOS_PER_USER=5000     todos one account may hold
# API_MAX_KEYS=5              API keys one account may create
# API_RATE_PER_MIN=60         requests per minute, per API key
# API_DAILY_QUOTA=2000        requests per UTC day, per API key
# MONGO_TIMEOUT_MS=6000       how long to wait for the database before failing fast
# DB_SLOW_MS=300              log queries slower than this

# Optional: Google sign-in (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: SMTP for password reset emails. If omitted, the reset link is printed
# to the server console (and shown on the page in development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ToDo Next <no-reply@example.com>"
